PORT=3021
NODE_ENV=development
LOG_LEVEL=info
TZ=America/Sao_Paulo

# Supabase packing house (service-role — never expose to browser)
SUPABASE_URL=https://supabase.packinghouse.noponto.io
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth (≥16 chars). Send as header X-Cron-Secret
CRON_SECRET=

# CMP218 SQL Server (read-only). Port 1433 — never 3389 (RDP).
MSSQL_HOST=20.206.161.176
MSSQL_PORT=1433
MSSQL_DATABASE=CMP218
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Sync window & filters
WISE_WINDOW_DAYS=2
WISE_EMPRESAS=1,2
# Comma-separated STATUS values to exclude from PEDFORN (tune after DISTINCT)
WISE_PEDFORN_STATUS_EXCLUIDOS=C,X,B,N,F,CANCELADO,BAIXADO,ANULADO
